# ─────────────────────────────────────────────────────────────
# SMTP configuration for contact / consultation form emails
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# SMTP server host (e.g. smtp.gmail.com, smtp.office365.com, smtp.zoho.com)
SMTP_HOST=

# SMTP port — 465 for SSL (secure=true), 587 for STARTTLS (secure=false)
SMTP_PORT=587

# Set to "true" only when using port 465 (implicit SSL)
SMTP_SECURE=false

# SMTP auth credentials (the mailbox that sends the message)
SMTP_USER=info@ibrahimdobarialaw.com
SMTP_PASS=

# The "From" address shown on outgoing mail (usually same as SMTP_USER)
MAIL_FROM="Dobaria Law PC <info@ibrahimdobarialaw.com>"

# Where form submissions are delivered (the firm's inbox).
# Update to info@dobarialaw.com once the client confirms the new address.
MAIL_TO=info@ibrahimdobarialaw.com
