# ─────────────────────────────────────────────────────────────
# SMTP configuration for contact / consultation form emails
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# SMTP server host (e.g. smtp.gmail.com, smtp.office365.com, smtp.zoho.com)
SMTP_HOST=

# SMTP port — 465 for SSL (secure=true), 587 for STARTTLS (secure=false)
SMTP_PORT=587

# Set to "true" only when using port 465 (implicit SSL)
SMTP_SECURE=false

# SMTP auth credentials (the mailbox that sends the message)
SMTP_USER=info@dobarialaw.com
SMTP_PASS=

# The "From" address shown on outgoing mail (usually same as SMTP_USER)
MAIL_FROM="Dobaria Law PC <info@dobarialaw.com>"

# Where form submissions are delivered (the firm's inbox).
MAIL_TO=info@dobarialaw.com

# ─────────────────────────────────────────────────────────────
# Clio Grow — optional lead capture
# When set, contact/consultation submissions also create an Inbox Lead in
# Clio Grow so a client profile is generated automatically.
# Find the token in Clio Grow → Settings → Inbox → Web Form.
# Leave blank to disable; the form still emails the firm either way.
# ─────────────────────────────────────────────────────────────
CLIO_GROW_INBOX_TOKEN=

# Override only if Clio provides a region-specific endpoint.
# Defaults to https://grow.clio.com/inbox_leads
CLIO_GROW_INBOX_URL=
