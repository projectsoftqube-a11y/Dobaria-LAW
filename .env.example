# ─────────────────────────────────────────────────────────────
# Mail — contact / consultation form delivery
#
# Sending goes through Microsoft Graph using an Entra app registration.
# No mailbox password is stored, and the sending address needs no Exchange
# licence, which is why this is used in preference to SMTP.
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored. Verify with:
#
#   npm run test:graph            # check the app registration authenticates
#   npm run test:graph -- --send  # send a real test email to MAIL_TO
#
# To create the app registration:
#   entra.microsoft.com → Applications → App registrations → New registration
#     · Single tenant, no redirect URI
#     · Overview tab supplies MS_CLIENT_ID and MS_TENANT_ID
#     · Certificates & secrets → New client secret → copy the VALUE
#       (not the Secret ID) into MS_CLIENT_SECRET
#     · API permissions → Microsoft Graph → APPLICATION permissions →
#       Mail.Send → Add → then "Grant admin consent"
#
# NOTE: the client secret expires (24 months by default). When it lapses the
# forms stop delivering silently — set a calendar reminder to renew it.
# ─────────────────────────────────────────────────────────────

MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The mailbox Graph sends as. Must be a real, licensed mailbox in the tenant —
# an address with no mailbox behind it is rejected with ErrorInvalidUser or
# MailboxNotEnabledForRESTAPI.
#
# The display name here is only a fallback: each submission overrides it with
# the enquirer's own name, so the firm's inbox shows who wrote in. The address
# cannot be the enquirer's — Exchange rejects sending as an address we do not
# own. Reply-To carries their address instead, so replying reaches them.
MAIL_FROM="Dobaria Law Website <vishal@dobarialaw.com>"

# Where enquiries are delivered. Accepts a comma-separated list.
MAIL_TO=vishal@dobarialaw.com

# ─────────────────────────────────────────────────────────────
# SMTP — optional fallback, used only when the MS_* values above are absent.
# Microsoft 365 requires SMTP AUTH to be enabled on the authenticating
# mailbox, and Microsoft is retiring basic authentication, so Graph is
# preferred for anything on Microsoft 365.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────────────────────
# Clio Grow — optional lead capture. When set, submissions also create an
# Inbox Lead so a client profile is generated automatically.
# Token: Clio Grow → Settings → Inbox → Web Form. Blank disables it; the
# form still emails the firm either way.
# ─────────────────────────────────────────────────────────────
CLIO_GROW_INBOX_TOKEN=
CLIO_GROW_INBOX_URL=
