# ─────────────────────────────────────────────────────────────
# SMTP — contact / consultation form email
#
# The firm's mailbox (info@dobarialaw.com) is on Microsoft 365 / Outlook,
# so the settings below are pre-filled for that. Copy this file to
# `.env.local` and add SMTP_PASS. `.env.local` is gitignored.
#
# IMPORTANT — Microsoft 365 does not accept a normal account password here.
# You must use ONE of:
#
#   A) An App Password (simplest)
#      Requires multi-factor authentication on the mailbox.
#      Microsoft 365 admin centre → Users → Active users → select the user →
#      Security info → Add sign-in method → App password.
#      Paste the generated password into SMTP_PASS below.
#
#   B) Enable SMTP AUTH for the mailbox (if App Passwords are unavailable)
#      Microsoft 365 admin centre → Users → Active users → select the user →
#      Mail tab → Manage email apps → tick "Authenticated SMTP" → Save.
#      Tenants often disable SMTP AUTH org-wide; an admin may need to run:
#        Set-TransportConfig -SmtpClientAuthenticationDisabled $false
#
# If neither is possible (some tenants block basic auth entirely), tell the
# developer — the route can be switched to Microsoft Graph or a relay such as
# Resend/SendGrid instead.
# ─────────────────────────────────────────────────────────────

# Microsoft 365 / Outlook SMTP endpoint.
SMTP_HOST=smtp.office365.com

# 587 with STARTTLS is the only port Microsoft 365 supports. Do not use 465.
SMTP_PORT=587

# Must stay "false" for port 587 (STARTTLS is negotiated after connecting).
SMTP_SECURE=false

# The mailbox that authenticates and sends.
SMTP_USER=info@dobarialaw.com

# App password (option A) or mailbox password with SMTP AUTH enabled (option B).
SMTP_PASS=

# The "From" header. Microsoft 365 requires this to match SMTP_USER, or to be
# an alias that mailbox is permitted to send as — otherwise sending is rejected.
MAIL_FROM="Dobaria Law PC <info@dobarialaw.com>"

# Where form submissions are delivered. Can be a different address, and accepts
# a comma-separated list (e.g. info@dobarialaw.com,vishal@dobarialaw.com).
MAIL_TO=info@dobarialaw.com

# ─────────────────────────────────────────────────────────────
# Clio Grow — optional lead capture
# When set, contact/consultation submissions also create an Inbox Lead in
# Clio Grow so a client profile is generated automatically.
# Find the token in Clio Grow → Settings → Inbox → Web Form.
# Leave blank to disable; the form still emails the firm either way.
# ─────────────────────────────────────────────────────────────
CLIO_GROW_INBOX_TOKEN=

# Override only if Clio provides a region-specific endpoint.
# Defaults to https://grow.clio.com/inbox_leads
CLIO_GROW_INBOX_URL=
